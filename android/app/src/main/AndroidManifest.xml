<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET, deliberately.
         =============================
         This was here for one reason: google_fonts fetched the typefaces at
         runtime. They ship in assets/fonts now and allowRuntimeFetching is off,
         so nothing in this app opens a socket. Nothing else needs it either —
         url_launcher hands a URL to the browser through an Intent, and the
         browser holds the permission; flutter_tts's network voices are
         synthesised in the engine's own process, not ours.

         Checked against the merged manifest rather than assumed: no plugin in
         this tree declares INTERNET, so removing it here removes it.

         It is worth more than the line it saves. "Collects nothing" is a promise
         about conduct; an app that cannot reach the network is a promise the
         system enforces, and it is the shortest possible answer on Play's data
         safety form. -->

    <!-- Read aloud, once the app is no longer on screen. audio_service runs the
         reading in a foreground service so the system does not suspend it, and
         puts the controls on the lock screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Since Android 13 a notification is only shown if the user has granted
         this, and a foreground service's notification is no exception. Without
         it the reading still runs, but the media controls never appear in the
         shade or on the lock screen — the feature looks half-built rather than
         un-permitted. Requested at the first reading, not at launch: see
         SpeechController.start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The reading, as a media session. MainActivity extends
             AudioServiceActivity so the service and the UI share one
             FlutterEngine; without that they would each get their own and the
             notification would be driving a queue nobody can see. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Headset and Bluetooth buttons: pause with a pinch, skip a verse
             with a double tap. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Read aloud. Since Android 11 an app sees only the packages it
             declares an interest in, and a text-to-speech engine is another
             package. Without this the engine is invisible, TextToSpeech fails
             to initialise, and every Listen button in the app is silent — with
             no error a reader could act on. flutter_tts does not declare it;
             it has to be here.
             https://developer.android.com/reference/android/speech/tts/TextToSpeech -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>

        <!-- The maker's links on the More tab. Same Android 11 rule: without
             this, url_launcher cannot see a browser and canLaunchUrl is false
             for every one of them. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
